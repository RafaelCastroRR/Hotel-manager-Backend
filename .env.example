# Server Configuration
PORT=3000

# Database Configuration (MongoDB Atlas Connection URI)
URI_MONGO=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxxx.mongodb.net/hotel_manager?retryWrites=true&w=majority

# Security
SECRETPRIVATEKEY=your_super_secret_jwt_key_here

# Cloudinary Configuration (For image uploads)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
